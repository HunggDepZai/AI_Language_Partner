
# Vietnamese Voice AI Assistant - Environment Configuration
# Copy this file to .env and add your own API keys.

# ── API Keys ──
OPENAI_API_KEY=your-openai-api-key
GROQ_API_KEY=your-groq-api-key

# ── STT: Speech-to-Text ──
# OpenAI: whisper-1
# Groq: whisper-large-v3
STT_PROVIDER=groq
STT_MODEL=whisper-large-v3

# ── LLM: Large Language Model ──
# OpenAI: gpt-4o-mini or gpt-4o
# Groq: llama-3.3-70b-versatile
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=500

# ── TTS: Text-to-Speech ──
TTS_ENGINE=edge
TTS_RATE=+0%
TTS_PITCH=+0Hz

# ── TTS Server (Optional) ──
VIETTTS_URL=http://localhost:8298

# ── Ollama (Optional) ──
OLLAMA_URL=http://localhost:11434

# ── General Settings ──
DEFAULT_VOICE=female
MAX_CONVERSATION_HISTORY=20

# ── VAD: Voice Activity Detection ──
VAD_THRESHOLD=0.5
VAD_SILENCE_DURATION=800
VAD_MIN_SPEECH=250
VAD_SPEECH_START_FRAMES=2
VAD_SILENCE_END_FRAMES=6

# ── Qdrant Cloud ──
QDRANT_URL=https://your-cluster-id.region.aws.cloud.qdrant.io
QDRANT_API_KEY=your-qdrant-api-key

# ── Embedding Model ──
EMBEDDING_MODEL=dangvantuan/vietnamese-embedding
