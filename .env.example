# ╔═══════════════════════════════════════════════════════╗
# ║   Vietnamese Voice AI Assistant - Cấu hình           ║
# ╠═══════════════════════════════════════════════════════╣
# ║  Copy file này thành .env rồi điền API key           ║
# ║  cp .env.example .env                                ║
# ╚═══════════════════════════════════════════════════════╝

# ── API Keys (BẮT BUỘC: chọn ít nhất 1) ──
OPENAI_API_KEY=sk-your-openai-key-here
GROQ_API_KEY=gsk_your-groq-key-here

# ── STT: Nhận dạng giọng nói ──
# Provider: "openai" (whisper-1) hoặc "groq" (whisper-large-v3, nhanh hơn)
STT_PROVIDER=openai
STT_MODEL=whisper-1

# ── LLM: Trí tuệ nhân tạo ──
# Provider: "openai", "groq", "ollama"
# Model: "gpt-4o-mini" (rẻ), "gpt-4o" (thông minh), "llama-3.3-70b-versatile" (groq free)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=500

# ── TTS: Giọng nói AI ──
# Engine: "edge" (miễn phí), "vieneu" (local), "viettts" (server)
TTS_ENGINE=edge
TTS_RATE=+0%
TTS_PITCH=+0Hz

# Nếu dùng VietTTS server
VIETTTS_URL=http://localhost:8298

# Nếu dùng Ollama local
OLLAMA_URL=http://localhost:11434

# ── Cai dat chung ──
DEFAULT_VOICE=female
MAX_CONVERSATION_HISTORY=20

# ── VAD: Phat hien giong noi (Full-Duplex) ──
# Nguong tin cay VAD (0.0 - 1.0, cao hon = nghiem ngat hon)
VAD_THRESHOLD=0.5
# Thoi gian im lang truoc khi coi la ket thuc luot noi (ms)
VAD_SILENCE_DURATION=800
# Thoi gian noi toi thieu de duoc tinh la hop le (ms)
VAD_MIN_SPEECH=250
# So frame lien tiep co giong noi de xac nhan bat dau noi
VAD_SPEECH_START_FRAMES=2
# So frame lien tiep im lang de xac nhan ngung noi
VAD_SILENCE_END_FRAMES=6
